{
  "name": "sleeping-village",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types scripts/physics-test.ts && node --experimental-strip-types scripts/camera-test.ts && node --experimental-strip-types scripts/journal-test.ts && node --experimental-strip-types scripts/mouse-capture-test.ts && node --experimental-strip-types scripts/audio-test.ts",
    "check:paths": "node scripts/check-paths.mjs",
    "check:domain": "node scripts/check-domain.mjs",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "@dimforge/rapier3d-compat": "^0.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
